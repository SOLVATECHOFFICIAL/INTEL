# ==============================================================================
# LASUED Intel — Environment Variables Template
# Copy to .env.local for local development or configure in Vercel Project Settings.
# Never commit real private keys or service-account JSON credentials to git.
# ==============================================================================

# --- Public Client Variables (safe to expose in Vite browser bundle) ----------
# Application display name override (defaults to "LASUED Intel")
VITE_APP_NAME=
# Canonical production public origin used for SEO, sitemaps, and share links
# Recommended value in production: https://lasuedintel.com.ng
VITE_PUBLIC_BASE_URL=
# Optional Web Push VAPID public key for browser push subscriptions
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# --- Server-Only Vercel Function Variables (NEVER prefix with VITE_) ----------
# Firestore database ID for Firebase Admin SDK (use "(default)" for lasued-intel)
FIREBASE_FIRESTORE_DATABASE_ID=
# Single-line JSON or base64-encoded Firebase Admin SDK service account for project "lasued-intel"
FIREBASE_SERVICE_ACCOUNT_JSON=
# Shared secret for authenticating internal/webhook calls to /api/push/*
PUSH_WEBHOOK_SECRET=
# Web Push VAPID key pair and contact subject (must match VITE_WEB_PUSH_VAPID_PUBLIC_KEY)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=