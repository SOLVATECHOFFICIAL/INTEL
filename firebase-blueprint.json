        "registrationUrl": { "type": "string", "maxLength": 512 },
        "contactInfo": { "type": "string", "maxLength": 256 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["upcoming", "ongoing", "completed", "past", "cancelled"] },
        "published": { "type": "boolean" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "notifiedNewAt": { "type": "string", "format": "date-time" },
        "lastUpdatedNoticeMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUID", "title", "description", "eventDate", "venue", "organiser", "status", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Private user notification item. Never reveals anonymous identities.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventType": { "type": "string", "enum": ["follow", "comment", "reply", "anonymous_reply", "reaction", "marketplace_approved", "marketplace_rejected", "marketplace_expired", "new_opportunity", "new_event", "badge_change", "account_change", "announcement"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "maxLength": 500 },
        "targetPath": { "type": "string", "maxLength": 256 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorUsername": { "type": "string", "maxLength": 32 },
        "actorName": { "type": "string", "maxLength": 100 },
        "actorPhotoUrl": { "type": "string", "maxLength": 512 },
        "actorPhotoImageId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetImageId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetImageUrl": { "type": "string", "maxLength": 512 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientUid", "eventType", "title", "isRead", "createdAt"]
    },
    "CampusPoll": {
      "title": "CampusPoll",
      "description": "Community poll attached to updates or campus topics.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "question": { "type": "string", "minLength": 5, "maxLength": 280 },
        "options": { "type": "array" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUID", "question", "options", "status", "expiresAt", "createdAt"]
    },
    "PlatformSetting": {
      "title": "PlatformSetting",
      "description": "System configuration documents managed only by Supreme Admin or Owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pinnedAnnouncementPostId": { "type": "string", "maxLength": 128 },
        "maintenanceNotice": { "type": "string", "maxLength": 400 },
        "marketplaceSubmissionsOpen": { "type": "boolean" },
        "anonymousPostingOpen": { "type": "boolean" },
        "newRegistrationsOpen": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "updatedByUid", "updatedAt"]
    },
    "MediaImage": {
      "title": "MediaImage",
      "description": "Separate Firestore document holding one client-compressed Base64 image (~100 KB target, hard-capped far below 1 MiB). Anonymous post images strictly omit ownerUID and filename metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetCollection": { "type": "string", "enum": ["users_avatar", "users_cover", "posts", "anonymousPosts", "marketplaceListings", "trustedContacts", "events"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mimeType": { "type": "string", "enum": ["image/webp", "image/jpeg"] },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "byteSize": { "type": "integer" },
        "base64Data": { "type": "string", "minLength": 24, "maxLength": 280000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetCollection", "targetId", "mimeType", "width", "height", "byteSize", "base64Data", "createdAt"]
    },
    "BadgeAuditLog": {
      "title": "BadgeAuditLog",
      "description": "Immutable internal audit log recording every badge/role assignment, promotion, demotion, removal, and account suspension action by Supreme Admin or Owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetUsername": { "type": "string", "maxLength": 32 },
        "action": {
          "type": "string",
          "enum": [
            "grant_verified",
            "remove_verified",
            "grant_moderator",
            "promote_verified_to_moderator",
            "demote_moderator_to_verified",
            "demote_moderator_to_member",
            "remove_moderator",
            "grant_supreme_admin",
            "remove_supreme_admin",
            "suspend_account",
            "restore_account"
          ]
        },
        "previousRole": { "type": "string", "enum": ["owner", "supreme_admin", "moderator", "verified", "member"] },
        "previousBadge": { "type": "string", "enum": ["none", "verified", "moderator", "supreme_admin"] },
        "nextRole": { "type": "string", "enum": ["owner", "supreme_admin", "moderator", "verified", "member"] },
        "nextBadge": { "type": "string", "enum": ["none", "verified", "moderator", "supreme_admin"] },
        "performedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "performedByRole": { "type": "string", "enum": ["owner", "supreme_admin"] },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetUid", "action", "previousRole", "previousBadge", "nextRole", "nextBadge", "performedByUid", "performedByRole", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable administrative and moderation audit trail covering marketplace reviews, content deletions, opportunities, events, trusted circle contacts, and platform settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": {
          "type": "string",
          "enum": [
            "marketplace_approved",
            "marketplace_rejected",
            "marketplace_removed",
            "marketplace_status_updated",
            "post_deleted",
            "anonymous_post_deleted",
            "post_comment_deleted",
            "anonymous_comment_deleted",
            "anonymous_report_dismissed",
            "anonymous_report_removed",
            "post_pinned",
            "post_unpinned",
            "post_official_toggled",
            "opportunity_created",
            "opportunity_updated",
            "opportunity_expired",
            "opportunity_deleted",
            "event_created",
            "event_updated",
            "event_cancelled",
            "event_deleted",
            "trusted_contact_created",
            "trusted_contact_updated",
            "trusted_contact_deleted",
            "settings_updated",
            "announcement_broadcast"
          ]
        },
        "targetCollection": { "type": "string", "minLength": 2, "maxLength": 64 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetLabel": { "type": "string", "maxLength": 180 },
        "performedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "performedByRole": { "type": "string", "enum": ["owner", "supreme_admin", "moderator"] },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "targetCollection", "targetId", "performedByUid", "performedByRole", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PublicUserProfile" },
      "description": "Public member profiles with directory visibility controls and zero private PII."
    },
    "/privateUserData/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUserData" },
      "description": "Private user email, phone, notification settings, and feed recommendation signals."
    },
    "/privateUserData/{userId}/anonymousHistory/{postId}": {
      "schema": { "$ref": "#/entities/PrivateAnonymousHistoryEntry" },
      "description": "Strictly owner-only private history pointers for anonymous posts authored by {userId}."
    },
    "/privateUserData/{userId}/pushSubscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/PushSubscriptionRecord" },
      "description": "Strictly owner-only Web Push subscriptions stored per device for authenticated push delivery."
    },
    "/userRoles/{userId}": {
      "schema": { "$ref": "#/entities/UserRoleRecord" },
      "description": "Trusted role and badge registry governing owner, supreme_admin, moderator, verified, and member permissions."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Unique lowercase username reservation lookup preventing duplicate usernames."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Main community feed posts (For You, Following, Latest) authored by Verified, Moderator, Supreme Admin, or Owner."
    },
    "/postComments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments and replies attached to ordinary community posts."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/FollowEdge" },
      "description": "Public follower/following edges between registered members."
    },
    "/postReactions/{reactionId}": {
      "schema": { "$ref": "#/entities/PostReaction" },
      "description": "User reactions (likes) on public and anonymous posts."
    },
    "/anonymousPosts/{postId}": {
      "schema": { "$ref": "#/entities/AnonymousPost" },
      "description": "Public anonymous posts for The Unfiltered with zero identifying metadata."
    },
    "/anonymousComments/{commentId}": {
      "schema": { "$ref": "#/entities/AnonymousComment" },
      "description": "Public anonymous comments and nested replies for The Unfiltered."
    },
    "/anonymousIdentityMappings/{entryId}": {
      "schema": { "$ref": "#/entities/AnonymousIdentityMapping" },
      "description": "Private mapping of anonymous post/comment IDs to author UID and role; readable only by Supreme Admin / Owner."
    },
    "/anonymousAuditLogs/{auditId}": {
      "schema": { "$ref": "#/entities/AnonymousAuditLog" },
      "description": "Audit records for Supreme Admin anonymous identity reveals; hidden from members and Moderators."
    },
    "/anonymousReports/{reportId}": {
      "schema": { "$ref": "#/entities/AnonymousReport" },
      "description": "Moderation reports submitted against anonymous posts or comments for Moderator/Admin review."
    },
    "/savedPosts/{savedId}": {
      "schema": { "$ref": "#/entities/SavedPost" },
      "description": "Private saved posts and listings per authenticated user."
    },
    "/marketplaceListings/{listingId}": {
      "schema": { "$ref": "#/entities/MarketplaceListing" },
      "description": "Campus marketplace listings with approval workflow, quantity state, and 7-day timestamp expiry."
    },
    "/trustedContacts/{contactId}": {
      "schema": { "$ref": "#/entities/TrustedContact" },
      "description": "Administrator-listed lecturer and student representative contacts (contact records only, not user accounts)."
    },
    "/opportunities/{opportunityId}": {
      "schema": { "$ref": "#/entities/Opportunity" },
      "description": "Verified scholarships, internships, grants, and jobs published by administrators."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CampusEvent" },
      "description": "Campus events published by administrators with automatic upcoming/past date filtering."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Private per-user notifications."
    },
    "/polls/{pollId}": {
      "schema": { "$ref": "#/entities/CampusPoll" },
      "description": "Campus polls."
    },
    "/platformSettings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSetting" },
      "description": "System-wide configuration documents."
    },
    "/mediaImages/{imageId}": {
      "schema": { "$ref": "#/entities/MediaImage" },
      "description": "Isolated compressed Base64 image documents (single-field indexing disabled on base64Data)."
    },
    "/badgeAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/BadgeAuditLog" },
      "description": "Immutable internal audit trail of all badge/role changes performed by Supreme Admin or Permanent Owner."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable administrative and moderation audit trail readable only by Supreme Admin or Permanent Owner."
    }
  }
}
