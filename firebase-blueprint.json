{
  "entities": {
    "PublicUserProfile": {
      "title": "PublicUserProfile",
      "description": "Publicly readable member profile information separated from private credentials and private contact data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "minLength": 4, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9_]+$" },
        "bio": { "type": "string", "maxLength": 500 },
        "department": { "type": "string", "maxLength": 120 },
        "faculty": { "type": "string", "maxLength": 120 },
        "level": { "type": "string", "maxLength": 32 },
        "photoUrl": { "type": "string", "maxLength": 512 },
        "coverUrl": { "type": "string", "maxLength": 512 },
        "publicEmail": { "type": "string", "maxLength": 160 },
        "publicWhatsapp": { "type": "string", "maxLength": 24 },
        "showWhatsappPublicly": { "type": "boolean" },
        "badge": { "type": "string", "enum": ["none", "verified", "moderator", "supreme_admin"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "isHiddenFromDirectory": { "type": "boolean" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "memberId", "fullName", "username", "badge", "accountStatus", "isHiddenFromDirectory", "showWhatsappPublicly", "followersCount", "followingCount", "createdAt", "updatedAt"]
    },
    "PrivateUserData": {
      "title": "PrivateUserData",
      "description": "Strictly private user account metadata, private contact details, notification preferences, and background recommendation signals.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "phoneNumber": { "type": "string", "maxLength": 24 },
        "whatsappNumber": { "type": "string", "maxLength": 24 },
        "notificationPrefs": { "type": "object" },
        "interestCategories": { "type": "array" },
        "ownedUsernames": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "authEmail", "updatedAt"]
    },
    "UserRoleRecord": {
      "title": "UserRoleRecord",
      "description": "Server/owner-governed authority and badge record. Never writable by ordinary users or self-escalated.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["owner", "supreme_admin", "moderator", "verified", "member"] },
        "badge": { "type": "string", "enum": ["none", "verified", "moderator", "supreme_admin"] },
        "isPermanentOwner": { "type": "boolean" },
        "isHiddenFromDirectory": { "type": "boolean" },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "badge", "isPermanentOwner", "isHiddenFromDirectory", "updatedAt"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Unique lowercase username reservation enforcing one-to-one mapping with uid and safe redirects for previous usernames.",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9_]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isPrimary": { "type": "boolean" },
        "redirectToUsername": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "ownerUID", "createdAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Ordinary community feed post (For You, Following, Latest). Publishable only by verified, moderator, supreme_admin, or owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorRole": { "type": "string", "enum": ["owner", "supreme_admin", "moderator", "verified"] },
        "category": { "type": "string", "minLength": 2, "maxLength": 64 },
        "title": { "type": "string", "maxLength": 180 },
        "body": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "mediaUrls": { "type": "array" },
        "isOfficial": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "deleted"] },
        "visibility": { "type": "string", "enum": ["public"] },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUID", "authorRole", "category", "body", "isOfficial", "isPinned", "status", "visibility", "likesCount", "commentsCount", "createdAt", "updatedAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment or reply on an ordinary community post.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentCommentId": { "type": "string", "maxLength": 128 },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "body": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "status": { "type": "string", "enum": ["published", "deleted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "ownerUID", "body", "status", "createdAt", "updatedAt"]
    },
    "FollowEdge": {
      "title": "FollowEdge",
      "description": "Directional follower relationship ({followerUid}_{targetUid}).",
      "type": "object",
      "properties": {
        "followerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerUid", "targetUid", "createdAt"]
    },
    "PostReaction": {
      "title": "PostReaction",
      "description": "Like or reaction on a public or anonymous post ({targetCollection}_{targetId}_{uid}).",
      "type": "object",
      "properties": {
        "targetCollection": { "type": "string", "enum": ["posts", "anonymousPosts"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reactionType": { "type": "string", "enum": ["like", "insightful", "support"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetCollection", "targetId", "ownerUID", "reactionType", "createdAt"]
    },
    "AnonymousPost": {
      "title": "AnonymousPost",
      "description": "Public anonymous post in The Unfiltered. Must NEVER contain author UID, email, phone, or profile identifiers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "minLength": 2, "maxLength": 64 },
        "body": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "status": { "type": "string", "enum": ["published", "deleted"] },
        "visibility": { "type": "string", "enum": ["public"] },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "category", "body", "status", "visibility", "likesCount", "commentsCount", "createdAt", "updatedAt"]
    },
    "AnonymousComment": {
      "title": "AnonymousComment",
      "description": "Public anonymous comment or nested reply in The Unfiltered. Must NEVER expose author UID or identity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentCommentId": { "type": "string", "maxLength": 128 },
        "body": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "status": { "type": "string", "enum": ["published", "deleted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "body", "status", "createdAt", "updatedAt"]
    },
    "AnonymousIdentityMapping": {
      "title": "AnonymousIdentityMapping",
      "description": "Strictly isolated mapping linking an anonymous post/comment ID to real author UID and role. Readable ONLY by Supreme Admin or Owner.",
      "type": "object",
      "properties": {
        "entryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entryType": { "type": "string", "enum": ["anonymousPosts", "anonymousComments"] },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorRole": { "type": "string", "enum": ["owner", "supreme_admin", "moderator", "verified", "member"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["entryId", "entryType", "authorUid", "authorRole", "createdAt"]
    },
    "AnonymousAuditLog": {
      "title": "AnonymousAuditLog",
      "description": "Private administrative audit trail recording every Supreme Admin anonymous-identity reveal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetEntryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "revealedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reason": { "type": "string", "minLength": 5, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetEntryId", "revealedByUid", "reason", "createdAt"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "Private user bookmark referencing a post or anonymous post.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetCollection": { "type": "string", "enum": ["posts", "anonymousPosts", "marketplaceListings", "opportunities"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUID", "targetCollection", "targetId", "createdAt"]
    },
    "MarketplaceListing": {
      "title": "MarketplaceListing",
      "description": "Product, service, or accommodation listing with approval workflow and 7-day timestamp-based expiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingKind": { "type": "string", "enum": ["product", "service", "accommodation"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "description": { "type": "string", "minLength": 5, "maxLength": 3000 },
        "category": { "type": "string", "minLength": 2, "maxLength": 64 },
        "price": { "type": "number" },
        "quantity": { "type": "integer" },
        "mediaUrls": { "type": "array" },
        "whatsappNumber": { "type": "string", "minLength": 7, "maxLength": 24 },
        "approvalStatus": { "type": "string", "enum": ["pending_approval", "approved", "rejected"] },
        "status": { "type": "string", "enum": ["pending_approval", "active", "sold", "expired", "rejected"] },
        "approvedByUid": { "type": "string", "maxLength": 128 },
        "visibility": { "type": "string", "enum": ["public", "owner_and_admins"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUID", "listingKind", "title", "description", "category", "price", "quantity", "whatsappNumber", "approvalStatus", "status", "visibility", "createdAt", "updatedAt", "expiresAt"]
    },
    "TrustedContact": {
      "title": "TrustedContact",
      "description": "Administrator-listed lecturer or student representative contact directory record (NOT a user account).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entryType": { "type": "string", "enum": ["admin_listed_contact"] },
        "isUserAccount": { "type": "boolean" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "enum": ["lecturer", "department_rep", "faculty_president", "class_rep", "departmental_executive", "student_union_rep"] },
        "roleTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "department": { "type": "string", "maxLength": 120 },
        "faculty": { "type": "string", "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 512 },
        "contactNumber": { "type": "string", "maxLength": 24 },
        "whatsappLink": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 600 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "entryType", "isUserAccount", "fullName", "category", "roleTitle", "createdByUid", "createdAt", "updatedAt"]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "Verified scholarship, internship, job, grant, or training published only by Supreme Admin or Owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["scholarship", "internship", "job", "competition", "grant", "training", "programme"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "organisation": { "type": "string", "minLength": 2, "maxLength": 140 },
        "description": { "type": "string", "minLength": 5, "maxLength": 5000 },
        "eligibility": { "type": "string", "maxLength": 1500 },
        "requiredDocuments": { "type": "string", "maxLength": 1500 },
        "benefits": { "type": "string", "maxLength": 1500 },
        "applicationInstructions": { "type": "string", "maxLength": 2000 },
        "applicationUrl": { "type": "string", "maxLength": 512 },
        "contactInfo": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["active", "expired"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUID", "category", "title", "organisation", "description", "applicationUrl", "status", "expiresAt", "createdAt", "updatedAt"]
    },
    "CampusEvent": {
      "title": "CampusEvent",
      "description": "Campus event published by permitted administrators with date/time for upcoming vs past categorization.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "description": { "type": "string", "minLength": 5, "maxLength": 5000 },
        "bannerUrl": { "type": "string", "maxLength": 512 },
        "eventDate": { "type": "string", "format": "date-time" },
        "timeLabel": { "type": "string", "maxLength": 64 },
        "venue": { "type": "string", "maxLength": 200 },
        "onlineMeetingUrl": { "type": "string", "maxLength": 512 },
        "organiser": { "type": "string", "maxLength": 140 },
        "registrationUrl": { "type": "string", "maxLength": 512 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["upcoming", "past", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUID", "title", "description", "eventDate", "venue", "organiser", "status", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Private user notification item. Never reveals anonymous identities.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventType": { "type": "string", "enum": ["comment", "reply", "anonymous_reply", "reaction", "marketplace_approved", "marketplace_rejected", "marketplace_expired", "new_opportunity", "new_event", "badge_change", "account_change", "announcement"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "maxLength": 500 },
        "targetPath": { "type": "string", "maxLength": 256 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientUid", "eventType", "title", "isRead", "createdAt"]
    },
    "CampusPoll": {
      "title": "CampusPoll",
      "description": "Community poll attached to updates or campus topics.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "question": { "type": "string", "minLength": 5, "maxLength": 280 },
        "options": { "type": "array" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUID", "question", "options", "status", "expiresAt", "createdAt"]
    },
    "PlatformSetting": {
      "title": "PlatformSetting",
      "description": "System configuration documents managed only by Supreme Admin or Owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "updatedByUid", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PublicUserProfile" },
      "description": "Public member profiles with directory visibility controls and zero private PII."
    },
    "/privateUserData/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUserData" },
      "description": "Private user email, phone, notification settings, and feed recommendation signals."
    },
    "/userRoles/{userId}": {
      "schema": { "$ref": "#/entities/UserRoleRecord" },
      "description": "Trusted role and badge registry governing owner, supreme_admin, moderator, verified, and member permissions."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Unique lowercase username reservation lookup preventing duplicate usernames."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Main community feed posts (For You, Following, Latest) authored by Verified, Moderator, Supreme Admin, or Owner."
    },
    "/postComments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments and replies attached to ordinary community posts."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/FollowEdge" },
      "description": "Public follower/following edges between registered members."
    },
    "/postReactions/{reactionId}": {
      "schema": { "$ref": "#/entities/PostReaction" },
      "description": "User reactions (likes) on public and anonymous posts."
    },
    "/anonymousPosts/{postId}": {
      "schema": { "$ref": "#/entities/AnonymousPost" },
      "description": "Public anonymous posts for The Unfiltered with zero identifying metadata."
    },
    "/anonymousComments/{commentId}": {
      "schema": { "$ref": "#/entities/AnonymousComment" },
      "description": "Public anonymous comments and nested replies for The Unfiltered."
    },
    "/anonymousIdentityMappings/{entryId}": {
      "schema": { "$ref": "#/entities/AnonymousIdentityMapping" },
      "description": "Private mapping of anonymous post/comment IDs to author UID and role; readable only by Supreme Admin / Owner."
    },
    "/anonymousAuditLogs/{auditId}": {
      "schema": { "$ref": "#/entities/AnonymousAuditLog" },
      "description": "Audit records for Supreme Admin anonymous identity reveals; hidden from members and Moderators."
    },
    "/savedPosts/{savedId}": {
      "schema": { "$ref": "#/entities/SavedPost" },
      "description": "Private saved posts and listings per authenticated user."
    },
    "/marketplaceListings/{listingId}": {
      "schema": { "$ref": "#/entities/MarketplaceListing" },
      "description": "Campus marketplace listings with approval workflow, quantity state, and 7-day timestamp expiry."
    },
    "/trustedContacts/{contactId}": {
      "schema": { "$ref": "#/entities/TrustedContact" },
      "description": "Administrator-listed lecturer and student representative contacts (contact records only, not user accounts)."
    },
    "/opportunities/{opportunityId}": {
      "schema": { "$ref": "#/entities/Opportunity" },
      "description": "Verified scholarships, internships, grants, and jobs published by administrators."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CampusEvent" },
      "description": "Campus events published by administrators with automatic upcoming/past date filtering."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Private per-user notifications."
    },
    "/polls/{pollId}": {
      "schema": { "$ref": "#/entities/CampusPoll" },
      "description": "Campus polls."
    },
    "/platformSettings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSetting" },
      "description": "System-wide configuration documents."
    }
  }
}
